{
  // Typechecks the WHOLE repository, not just what ships.
  //
  // `tsconfig.json` includes only `src`, so for a long time `npx tsc --noEmit`
  // had never looked at `scripts/` or `test/` — and vitest transpiles without
  // typechecking, so nothing looked at them at all. A typo in a measurement
  // script produced `undefined` in silence, and a test could assert on a field
  // that did not exist and pass forever. See test/typecheck.test.ts, which runs
  // this config as part of the suite.
  //
  //     npx tsc -p tsconfig.all.json --noEmit
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src", "scripts", "test"]
}
